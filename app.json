{
  "expo": {
    "name": "Thiam LLM Language Translator",
    "slug": "language-translator",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "language-translator",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphatronex.languagetranslator",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record your voice so it can be translated into another language.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alphatronex.languagetranslator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0F1117"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "This app uses the microphone to record your voice so it can be translated into another language."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f25cc59a-6ac9-459c-bb49-e722997f071c"
      }
    }
  }
}
